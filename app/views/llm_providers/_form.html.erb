<%= form_with model: provider, class: "col-lg-7" do |f| %>
  <% if provider.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0"><% provider.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :key, "Key", class: "form-label" %>
    <% if provider.persisted? %>
      <%= f.text_field :key, class: "form-control", readonly: true %>
      <div class="form-text">
        The key selects the adapter, so changing it would silently repoint every
        model beneath it at a different vendor.
      </div>
    <% else %>
      <%= f.select :key, LlmClients.supported_keys, { include_blank: "—" }, class: "form-select" %>
      <div class="form-text">
        These are the vendors this application has an adapter for. Anything else
        can be registered, but nothing under it can be certified.
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :name, "Display name", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "Anthropic" %>
  </div>

  <div class="mb-3">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status, LlmProvider::STATUSES, {}, class: "form-select" %>
    <div class="form-text">Inactive providers stay in the record; nothing routes to their models.</div>
  </div>

  <div class="mb-3">
    <%= f.label :notes, class: "form-label" %>
    <%= f.text_area :notes, rows: 3, class: "form-control" %>
  </div>

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", llm_providers_path, class: "btn btn-link" %>
<% end %>
