<% content_for :title, "Providers" %>
<div class="d-flex justify-content-between align-items-start">
  <div>
    <h1 class="h3">Providers</h1>
    <p class="text-body-secondary" style="max-width: 46rem;">
      A provider is <em>callable</em> only if this application ships an adapter for it
      and the credential is present in the environment. Registering one that is
      neither is allowed — it just cannot be certified, because vouching for a
      model the code cannot reach would claim a capability that does not exist.
    </p>
  </div>
  <% if policy(LlmProvider).create? %>
    <%= link_to "Register a provider", new_llm_provider_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table align-middle bg-body shadow-sm">
  <thead class="text-body-secondary">
    <tr><th>Provider</th><th>Adapter</th><th>Credential</th><th>Status</th><th>Models</th><th></th></tr>
  </thead>
  <tbody>
    <% @providers.each do |provider| %>
      <tr>
        <td>
          <%= provider.name %>
          <div class="small text-body-secondary"><code><%= provider.key %></code></div>
        </td>
        <td>
          <% if provider.invocable? %>
            <span class="badge text-bg-success">present</span>
          <% else %>
            <span class="badge text-bg-secondary">none</span>
            <div class="small text-body-secondary">cannot be called</div>
          <% end %>
        </td>
        <td class="small">
          <% if provider.credential_env.nil? %>
            <span class="text-body-secondary">—</span>
          <% elsif provider.credentialed? %>
            <span class="text-success">set</span>
            <div class="text-body-secondary"><code><%= provider.credential_env %></code></div>
          <% else %>
            <span class="text-warning-emphasis">missing</span>
            <div class="text-body-secondary">export <code><%= provider.credential_env %></code></div>
          <% end %>
        </td>
        <td>
          <span class="badge text-bg-<%= provider.active? ? "primary" : "secondary" %>"><%= provider.status %></span>
        </td>
        <td>
          <%= provider.llm_models.size %>
          <% certified = provider.llm_models.count(&:certified?) %>
          <% if certified.positive? %>
            <span class="small text-body-secondary">(<%= certified %> certified)</span>
          <% end %>
        </td>
        <td class="text-end">
          <% if policy(provider).edit? %>
            <%= link_to "Edit", edit_llm_provider_path(provider), class: "btn btn-sm btn-outline-secondary" %>
          <% end %>
          <% if policy(LlmModel).new? && provider.invocable? %>
            <%= link_to "Add model", new_llm_model_path(llm_provider_id: provider.id),
                        class: "btn btn-sm btn-outline-primary" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="small text-body-secondary">
  Credentials are read from the environment, never stored here. A key in the
  database would be a secret in the audit trail, and this system records
  judgements, not credentials.
</p>
