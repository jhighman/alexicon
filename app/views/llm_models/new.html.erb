<% content_for :title, "Register a model" %>
<h1 class="h3">Register a model</h1>
<p class="text-body-secondary" style="max-width: 42rem;">
  Registering records that the model exists. It arrives <strong>pending</strong>,
  and nothing routes to it until someone certifies it under their own name.
</p>

<%= form_with model: @model, class: "col-lg-7" do |f| %>
  <% if @model.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0"><% @model.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :llm_provider_id, "Provider", class: "form-label" %>
    <%= f.collection_select :llm_provider_id, @providers, :id,
                            ->(p) { p.invocable? ? p.name : "#{p.name} (no adapter)" },
                            { include_blank: "—" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :model_identifier, "Model ID", class: "form-label" %>
    <%= f.text_field :model_identifier, class: "form-control", placeholder: "claude-opus-5" %>
    <div class="form-text">Exactly as the vendor's API expects it — this string is sent on every call.</div>
  </div>

  <div class="mb-3">
    <%= f.label :display_name, class: "form-label" %>
    <%= f.text_field :display_name, class: "form-control", placeholder: "Claude Opus 5" %>
  </div>

  <div class="row">
    <div class="col mb-3">
      <%= f.label :cost_per_1k_input, "Cost / 1k input", class: "form-label" %>
      <%= f.number_field :cost_per_1k_input, step: "0.000001", class: "form-control" %>
    </div>
    <div class="col mb-3">
      <%= f.label :cost_per_1k_output, "Cost / 1k output", class: "form-label" %>
      <%= f.number_field :cost_per_1k_output, step: "0.000001", class: "form-control" %>
    </div>
  </div>
  <div class="form-text mb-3">
    Used to cost every invocation. Wrong rates make the spend record wrong; they
    do not stop a call.
  </div>

  <%= f.submit "Register", class: "btn btn-primary" %>
  <%= link_to "Cancel", llm_models_path, class: "btn btn-link" %>
<% end %>
