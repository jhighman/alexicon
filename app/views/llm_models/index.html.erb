<% content_for :title, "Model registry" %>
<div class="d-flex justify-content-between align-items-start">
  <div>
    <h1 class="h3">Model registry</h1>
    <p class="text-body-secondary" style="max-width: 46rem;">
      A model may not influence any judgement until a named person certifies it.
      Revocation is terminal — register a replacement rather than re-certifying,
      so the record of why it was withdrawn stays legible.
    </p>
  </div>
  <div class="text-end text-nowrap">
    <%= link_to "Providers", llm_providers_path, class: "btn btn-outline-secondary" if policy(LlmProvider).index? %>
    <%= link_to "Register a model", new_llm_model_path, class: "btn btn-primary" if policy(LlmModel).new? %>
  </div>
</div>

<table class="table align-middle bg-body shadow-sm">
  <thead class="text-body-secondary">
    <tr><th>Model</th><th>Provider</th><th>Cost / 1k</th><th>Status</th><th>Vouched by</th><th></th></tr>
  </thead>
  <tbody>
    <% @models.each do |model| %>
      <tr>
        <td><code><%= model.model_identifier %></code><div class="small text-body-secondary"><%= model.display_name %></div></td>
        <td>
          <%= model.llm_provider.name %>
          <% unless model.invocable? %>
            <div class="small text-body-secondary">no adapter — cannot be certified</div>
          <% end %>
        </td>
        <td class="small">in <%= number_to_currency(model.cost_per_1k_input, precision: 4) %> ·
            out <%= number_to_currency(model.cost_per_1k_output, precision: 4) %></td>
        <td>
          <% tone = { "certified" => "success", "revoked" => "danger" }.fetch(model.certification_status, "secondary") %>
          <span class="badge text-bg-<%= tone %>"><%= model.certification_status %></span>
        </td>
        <td class="small text-body-secondary">
          <% if model.certified_by %>
            <%= model.certified_by.name %><br><%= model.certified_at&.to_fs(:short) %>
          <% else %>—<% end %>
          <% if model.revoked? %><div class="text-danger"><%= model.revocation_reason %></div><% end %>
        </td>
        <td class="text-end">
          <% if policy(model).certify? && !model.certified? && !model.revoked? %>
            <%= button_to "Certify", certify_llm_model_path(model), class: "btn btn-sm btn-primary",
                          disabled: !model.invocable? %>
          <% elsif policy(model).revoke? && model.certified? %>
            <%= button_to "Revoke", revoke_llm_model_path(model), class: "btn btn-sm btn-outline-danger",
                          form: { data: { turbo_confirm: "Revocation is terminal. Continue?" } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2 class="h5 mt-4">Assignments</h2>
<p class="text-body-secondary" style="max-width: 46rem;">
  Which model answers for which caller. A rule naming an act beats one matching
  any act, and an exact caller beats a pattern; priority is only the tie-break.
  There is no fallback — an unmatched caller does not run at all.
</p>

<% if @assignments.empty? %>
  <p class="text-body-secondary">None. A certified model still needs an assignment before anything routes to it.</p>
<% else %>
  <ul class="list-group shadow-sm">
    <% @assignments.each do |a| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span><code><%= a.scope_description %></code> → <%= a.llm_model.display_name %></span>
        <span class="small text-body-secondary">
          specificity <%= a.specificity %> · priority <%= a.priority %>
          <% if policy(a).destroy? %>
            <%= button_to "Remove", llm_assignment_path(a), method: :delete,
                          class: "btn btn-sm btn-link text-danger p-0 ms-2",
                          form_class: "d-inline" %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>

<% if policy(LlmAssignment).create? %>
  <%= form_with model: @assignment, class: "row g-2 align-items-end mt-3" do |f| %>
    <div class="col-md-3">
      <%= f.label :agent_pattern, "Caller", class: "form-label small" %>
      <%= f.text_field :agent_pattern, class: "form-control form-control-sm",
                       placeholder: "claim-classifier or *-sentinel", list: "agent-keys" %>
    </div>
    <div class="col-md-2">
      <%= f.label :action_type, "Act", class: "form-label small" %>
      <%= f.select :action_type, Assertion::ACTS, { include_blank: "any act" },
                   class: "form-select form-select-sm" %>
    </div>
    <div class="col-md-3">
      <%= f.label :llm_model_id, "Model", class: "form-label small" %>
      <%= f.collection_select :llm_model_id, LlmModel.assignable.order(:display_name),
                              :id, :display_name, { include_blank: "—" },
                              class: "form-select form-select-sm" %>
    </div>
    <div class="col-md-2">
      <%= f.label :priority, class: "form-label small" %>
      <%= f.number_field :priority, value: 0, class: "form-control form-control-sm" %>
    </div>
    <div class="col-md-2">
      <%= f.submit "Route", class: "btn btn-sm btn-outline-primary w-100" %>
    </div>
  <% end %>
  <datalist id="agent-keys">
    <% Referent.where(primitive: "system").order(:key).pluck(:key).each do |key| %>
      <option value="<%= key %>"></option>
    <% end %>
  </datalist>
<% end %>
