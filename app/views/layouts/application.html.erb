<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Alexicon" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Alexicon">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-body-tertiary">
    <nav class="navbar navbar-expand bg-dark border-bottom border-body" data-bs-theme="dark">
      <div class="container">
        <%= link_to "Alexicon", root_path, class: "navbar-brand fw-semibold" %>
        <div class="navbar-nav me-auto">
          <% if signed_in? %>
            <%= link_to "Documents", documents_path, class: "nav-link" %>
            <% if current_user.can_ingest? %>
              <%= link_to "Review a text", new_document_path, class: "nav-link" %>
            <% end %>
            <% if current_user.can_view_llm_registry? %>
              <%= link_to "Models", llm_models_path, class: "nav-link" %>
              <%= link_to "Providers", llm_providers_path, class: "nav-link" %>
              <%= link_to "Invocations", llm_invocations_path, class: "nav-link" %>
            <% end %>
          <% end %>
        </div>
        <div class="navbar-text small">
          <% if signed_in? %>
            <span class="text-white fw-semibold"><%= current_user.username %></span>
            <span class="badge text-bg-secondary"><%= current_user.role %></span>
            <%= button_to "sign out", session_path, method: :delete,
                          class: "btn btn-link btn-sm p-0 align-baseline link-light" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "link-light" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if notice %>
        <div class="alert alert-success" role="status"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning" role="alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
