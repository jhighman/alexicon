<% content_for :title, @document.title.presence || "Document" %>
<% label, tone, explanation = document_state(@document) %>

<div class="d-flex justify-content-between align-items-start mb-3">
  <div>
    <h1 class="h3 mb-1"><%= @document.title.presence || "Untitled" %></h1>
    <p class="text-body-secondary mb-0 small">
      <%= pluralize(@document.claims.count, "claim") %> ·
      <%= pluralize(@document.mentions.count, "mention") %> ·
      <%= pluralize(@document.transitions.count, "step") %>
    </p>
  </div>
  <span class="badge text-bg-<%= tone %> fs-6 flex-shrink-0"><%= label %></span>
</div>

<div class="alert alert-<%= tone %>" role="status"><%= explanation %></div>

<%# ---- Analysis controls ---------------------------------------------------- %>
<section class="card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="flex-grow-1" style="min-width: 16rem;">
      <%= turbo_stream_from @document, :classification %>
      <%= render "documents/classification_progress", document: @document,
                 status: nil, current: nil, outcome: nil, error: nil %>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
      <% if current_user.can_review? %>
        <%= button_to "Classify claims", classify_document_path(@document),
                      class: "btn btn-sm btn-primary" %>
        <%= button_to "Judge the steps", govern_document_path(@document),
                      class: "btn btn-sm btn-outline-primary",
                      disabled: !@document.executable? || !@document.classified? %>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Identity questions, one per name ------------------------------------ %>
<% if @identity_groups.any? %>
  <section class="mb-4">
    <div class="d-flex justify-content-between align-items-start gap-3">
      <h2 class="h5">Names with no established reference</h2>
      <% if current_user.can_review? %>
        <%= button_to "Ask the model", propose_identities_document_path(@document),
                      class: "btn btn-sm btn-outline-primary flex-shrink-0" %>
      <% end %>
    </div>
    <p class="text-body-secondary small" style="max-width: 46rem;">
      A flag never says a claim is false. A name here is not a name that is
      wrong — it is one this system has never been introduced to, and it is
      asked once however often the name appears.
    </p>
    <p class="text-body-secondary small" style="max-width: 46rem;">
      Claims are still classified meanwhile: typing a statement does not
      predicate anything of the names inside it. What waits on these answers is
      judging the steps between claims, which does reason about what they refer to.
    </p>

    <% @identity_groups.each do |name, flags| %>
      <div class="card mb-2 border-danger">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-baseline gap-3">
            <div>
              <code class="fs-6"><%= name %></code>
              <span class="badge text-bg-light border ms-1"><%= pluralize(flags.size, "occurrence") %></span>
            </div>
            <span class="small text-body-secondary"><%= flags.first.message %></span>
          </div>

          <% mention = flags.first.subject %>
          <% proposal = mention.identity_proposal %>

          <% if proposal %>
            <div class="mt-2 small">
              <span class="badge text-bg-light border">proposed</span>
              <% if proposal.claim["proposal"] == "not_a_subject" %>
                not a subject
              <% else %>
                <strong><%= name %> → <%= proposal.claim["subject"] %> → <%= proposal.claim["role"] %></strong>
              <% end %>
              <span class="text-body-secondary">
                by <%= proposal.asserter.name %><% if proposal.confidence %>
                · <%= number_to_percentage(proposal.confidence * 100, precision: 0) %><% end %>
                — <%= proposal.rationale %>
              </span>
            </div>
          <% end %>

          <% if current_user.can_review? %>
            <div class="row g-2 align-items-end mt-2">
              <%= form_with url: ground_mention_path(mention), class: "col d-flex gap-2 align-items-end" do %>
                <div>
                  <label class="form-label small mb-1" for="subject-<%= mention.id %>">subject</label>
                  <input class="form-control form-control-sm" id="subject-<%= mention.id %>"
                         name="referent[subject]" placeholder="e.g. Person" required
                         value="<%= proposal&.claim&.dig('subject') %>">
                </div>
                <div>
                  <label class="form-label small mb-1" for="role-<%= mention.id %>">role</label>
                  <input class="form-control form-control-sm" id="role-<%= mention.id %>"
                         name="referent[role]" placeholder="e.g. Philosopher" required
                         value="<%= proposal&.claim&.dig('role') %>">
                </div>
                <button class="btn btn-sm btn-primary" type="submit">
                  <%= proposal&.claim&.dig("proposal") == "subject" ? "Accept" : "Ground it" %>
                </button>
              <% end %>
              <div class="col-auto">
                <%= button_to (proposal&.claim&.dig("proposal") == "not_a_subject" ? "Accept: not a subject" : "Not a subject"),
                              ignore_mention_path(mention),
                              class: "btn btn-sm #{proposal&.claim&.dig('proposal') == 'not_a_subject' ? 'btn-primary' : 'btn-outline-secondary'}",
                              form: { data: { turbo_confirm: "#{name.inspect} will never be proposed as a subject again. Continue?" } } %>
              </div>
            </div>
            <div class="form-text mt-2">
              A passport needs all three levels — a partial one is not a weaker anchor, it is no anchor.
              A proposal is inference; accepting it is your judgement, recorded under your name.
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<%# ---- Flags waiting on a person ------------------------------------------- %>
<% if @open_flags.any? %>
  <section class="mb-4">
    <h2 class="h5">Waiting on you</h2>
    <p class="text-body-secondary small">
      A flag never says a claim is false. It says the conditions for proceeding were
      not satisfied. You may let it stand or set it aside; either way your answer is
      recorded alongside it, and the flag itself is never altered.
    </p>

    <% @open_flags.each do |flag| %>
      <div class="card mb-2 border-<%= flag.stop? ? 'danger' : 'warning' %>">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-3">
            <div>
              <div class="mb-1">
                <%= severity_badge(flag) %>
                <span class="text-body-secondary small">
                  raised by <%= flag.asserter.name %> about <%= flag_subject_label(flag) %>
                </span>
              </div>
              <p class="mb-0"><%= flag.message %></p>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
              <% if current_user.can_review? %>
              <%= button_to "Let it stand", flag_path(flag),
                            method: :patch, params: { disposition: "accepted" },
                            class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Set aside", flag_path(flag),
                            method: :patch, params: { disposition: "rejected" },
                            class: "btn btn-sm btn-outline-secondary" %>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </section>
<% end %>

<%# ---- Claims --------------------------------------------------------------- %>
<section class="mb-4">
  <h2 class="h5">Claims</h2>
  <div class="list-group shadow-sm">
    <% @claims.each do |claim| %>
      <div class="list-group-item">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <span class="text-body-secondary small me-2"><%= claim.position %>.</span>
            <span><%= claim.text %></span>
            <% if claim.mentions.any? %>
              <div class="mt-2 small">
                <% claim.mentions.each do |mention| %>
                  <span class="me-2">
                    <code><%= mention.text %></code>
                    <%= mention_status_badge(mention) %>
                    <% if mention.referent %>
                      <span class="text-body-secondary"><%= mention.referent.passport %></span>
                    <% end %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="text-end flex-shrink-0">
            <%= category_badge(claim.category) %>
            <% if (c = claim.classification) %>
              <div class="small text-body-secondary mt-1" title="<%= c.rationale %>">
                <%= c.inferred? ? "inferred" : "decided" %> by <%= c.asserter.name %>
                <% if c.confidence %>· <%= number_to_percentage(c.confidence * 100, precision: 0) %><% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%# ---- Steps between claims ------------------------------------------------- %>
<% if @transitions.any? %>
  <section class="mb-4">
    <h2 class="h5">Steps</h2>
    <p class="text-body-secondary small">
      The step between claims — not the claim — is the unit of risk. A claim may be
      sound; the danger is the unannounced promotion between two of them.
    </p>
    <div class="table-responsive">
      <table class="table table-sm align-middle bg-body">
        <thead>
          <tr class="text-body-secondary">
            <th scope="col">From</th><th scope="col">To</th>
            <th scope="col">Category change</th><th scope="col">Verdict</th><th scope="col">Judged by</th>
          </tr>
        </thead>
        <tbody>
          <% @transitions.each do |t| %>
            <tr>
              <td class="text-body-secondary"><%= t.from_claim&.position %></td>
              <td class="text-body-secondary"><%= t.to_claim&.position %></td>
              <td>
                <% if t.category_change? %>
                  <%= category_badge(t.from_claim.category) %> →
                  <%= category_badge(t.to_claim.category) %>
                <% else %>
                  <span class="text-body-secondary small">no change</span>
                <% end %>
              </td>
              <td><%= verdict_badge(t.verdict) %></td>
              <td class="small text-body-secondary">
                <%= t.history.last&.asserter&.name || "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<%# ---- Audit trail ---------------------------------------------------------- %>
<section>
  <h2 class="h5">Record</h2>
  <p class="text-body-secondary small">
    Every judgement is immutable. Corrections are answered by later assertions rather
    than written over the original, so the whole history stays inspectable.
  </p>
  <div class="list-group list-group-flush bg-body rounded shadow-sm">
    <% @history.each do |assertion| %>
      <div class="list-group-item d-flex justify-content-between align-items-baseline">
        <div>
          <span class="badge text-bg-light border me-2"><%= assertion.act %></span>
          <span class="fw-semibold"><%= assertion.asserter.name %></span>
          <span class="text-body-secondary small">
            <%= assertion.message.presence || assertion.rationale.presence ||
                assertion.claim.except("severity", "message", "rationale").to_json %>
          </span>
        </div>
        <span class="text-body-secondary small flex-shrink-0 ms-3">
          <%= assertion.asserted_at.strftime("%H:%M:%S") %>
        </span>
      </div>
    <% end %>
  </div>
</section>

<div class="mt-4">
  <%= link_to "← All documents", documents_path, class: "link-secondary" %>
</div>
