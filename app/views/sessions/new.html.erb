<% content_for :title, "Sign in" %>
<div class="row justify-content-center">
  <div class="col-lg-4">
    <h1 class="h3">Sign in</h1>
    <p class="text-body-secondary small">
      Your role decides what you may do. Whatever you decide is recorded against
      the person you sign in as.
    </p>
    <%= form_with url: session_path, method: :post do %>
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input class="form-control" id="username" name="username" autofocus autocomplete="username">
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password"
               autocomplete="current-password">
      </div>
      <button class="btn btn-primary" type="submit">Sign in</button>
    <% end %>
    <p class="form-text mt-3">
      No account yet? <code>bin/rails "alexicon:user[name,password,role]"</code>
      — roles: admin, auditor, reviewer, viewer.
    </p>
  </div>
</div>
